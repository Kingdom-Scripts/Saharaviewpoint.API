{
  "AppConfig": {
    "AllowedHosts": [
      "http://localhost:4200",
      "http://localhost:4201"
    ],
    "ApiVideoUrl": "https://sandbox.api.video",
    "BaseUrLs": {
      "Api": "https://localhost:7023",
      "AssetBase": "https://localhost:7023/api/v1/assets",
      "Admin": "http://localhost:4200",
      "Client": "http://localhost:4200"
    },
    "FileSettings": {
      "FilePath": "uploads",
      "RequestPath": "/uploads",
      "MaxSizeLength": 2097152,
      "PermittedFileTypes": [ ".png", ".jpg", ".jpeg", ".pdf" ]
    },
    "KeyVaultUrl": "https://svp-staging-key-vault.vault.azure.net/"
  },
  "JwtConfig": {
    "Expires": "30",
    "RefreshExpireDays": "31",
    "Issuer": "https://api.saharaviewpoint.com",
    "Audience": "https://saharaviewpoint.com",
    "AllowedDomains": "http://localhost:5255,http://localhost:4200,http://localhost:4201,https://svp-client-test.vercel.app,https://saharaviewpoint-api.azurewebsites.net,https://kind-bush-09e4af50f.4.azurestaticapps.net,https://admin.saharaviewpoint.com"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "/logs/SaharaviewpointAPI/Log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "fileSizeLimitBytes": 5242880,
          "rollOnFileSizeLimit": true
        }
      }
    ]
  },
  "ZeptoMail": {
    "DefaultSenderAssdress": "no-reply@staging.saharaviewpoint.com",
    "DefaultSenderName": "Saharaviewpoint (Staging)"
  }
}